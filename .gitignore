# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging / build artifacts
build/
dist/
sdist/
wheels/
*.egg
*.egg-info/
.eggs/
MANIFEST

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Test / coverage / type-check caches
.pytest_cache/
.tox/
.nox/
.cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pyre/
.pytype/

# ---------------------------------------------------------------------------
# Helm
# ---------------------------------------------------------------------------
# Chart dependencies are vendored on `helm dep build`; don't commit the tarballs.
**/charts/*.tgz
*.tgz

# ---------------------------------------------------------------------------
# Secrets / local overrides
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local.yaml
*.local.yml

# ---------------------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Go / kubebuilder
# ---------------------------------------------------------------------------
*.exe
*.exe~
*.dll
*.dylib
bin/*
Dockerfile.cross

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Go workspace file
go.work

# Kubernetes generated files — skip generated files, except vendored ones
!vendor/**/zz_generated.*

# Kubeconfig might contain secrets
*.kubeconfig
